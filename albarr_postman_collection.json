{
  "info": {
    "_postman_id": "albarr-crowdfunding-api",
    "name": "Al-Barr Crowdfunding API",
    "description": "Production API Collection for Al-Barr Crowdfunding Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@albarr.org\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "Get All Campaigns",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/campaigns",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "campaigns"]
            }
          }
        },
        {
          "name": "Create New Campaign",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": { \"ar\": \"مبادرة تشجير الحي الأخضر\", \"en\": \"Green District Initiative\" },\n  \"description\": { \"ar\": \"زراعة 1000 شجرة مثمرة وظليلة في الأحياء السكنية.\", \"en\": \"Planting 1000 trees across residential zones.\" },\n  \"category\": { \"ar\": \"بيئة وتنمية\", \"en\": \"Environment\" },\n  \"goal\": 50000,\n  \"daysLeft\": 25,\n  \"image\": \"https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=800&q=80\",\n  \"author\": { \"ar\": \"فريق بصمة خضراء\", \"en\": \"Green Team\", \"email\": \"green@albarr.org\" }\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/campaigns",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "campaigns"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Donation / Pledge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": \"{{campaign_id}}\",\n  \"amount\": 500,\n  \"donorName\": \"فاعل خير\",\n  \"method\": \"InstaPay\",\n  \"cheerMessage\": \"بالتوفيق وجزاكم الله خيراً\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/transactions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/transactions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "transactions"]
            }
          }
        }
      ]
    }
  ]
}